# MCPE Galaxy Production Environment Variables

# Database Connection URL (Vercel Postgres, Neon, Supabase, or standard PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/mcpegalaxy

# Admin Security Passkey for Server-Side API Authentication
ADMIN_PASSWORD=mcpegalaxy123

# Discord Webhook URL for Real-Time Audit Logs & Promotions
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
# ALL events (players, applications, matches, staff, settings, Discord login/logout) post here.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Server Base URL
APP_URL=http://localhost:3000

# Google Gemini API Key (Server-side)
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------- Discord OAuth2 Login ----------------
# From https://discord.com/developers/applications -> Your App -> OAuth2
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
# Must exactly match a Redirect URI registered in the Discord Developer Portal
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Long random string used to sign session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=change_this_to_a_long_random_string
